# Domínio das contas XMPP: usuario@localhost.
XMPP_DOMAIN=localhost

# Login administrativo: admin@localhost.
EJABBERD_ADMIN_USER=admin
# Ao criar seu próprio .env, substitua o valor abaixo por uma senha.
EJABBERD_ADMIN_PASSWORD=defina_sua_senha_aqui

# Portas disponíveis na máquina que executa o Docker.
EJABBERD_WEB_PORT=5280
EJABBERD_HTTPS_PORT=5443
EJABBERD_XMPP_PORT=5222

# Opcional: URL pública do WebSocket. Vazio usa ws://<host>:<EJABBERD_WEB_PORT>/websocket.
XMPP_WEBSOCKET_URL=

# Aplicação de cadastro Django: gere uma chave própria antes de iniciar.
DJANGO_SECRET_KEY=defina_uma_chave_aleatoria_longa_para_o_django
DJANGO_WEB_PORT=8000
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,[::1]

# Comunicação interna entre os containers; estas não são portas da máquina.
EJABBERD_API_HOST=ejabberd
EJABBERD_API_PORT=5443
# Nome presente no certificado da imagem oficial usada neste laboratório.
EJABBERD_TLS_SERVER_NAME=localhost
